# PaoPaoDNS Web UI Backend Configuration
# Copy this file to .env and fill in your values

# Data directory (shared with PaoPaoDNS container)
DATA_DIR=/data

# Web UI authentication token (REQUIRED for security)
# Generate with: openssl rand -hex 32
WEB_UI_TOKEN=your-secure-token-here

# Allow access without authentication (NOT RECOMMENDED)
# Only set to true for local testing in isolated environments
WEB_UI_ALLOW_NO_AUTH=false

# Trusted reverse proxy IPs/CIDRs allowed to supply X-Forwarded-For.
# Leave empty when running directly.
WEB_UI_TRUSTED_PROXIES=

# DNS test target (container name or IP that Web UI can reach)
DNS_TEST_SERVER=paopaodns
DNS_TEST_PORT=53
DNS_TEST_TIMEOUT=3

# Runtime environment variables (mirrored from PaoPaoDNS container)
# These help Web UI accurately determine auto-reload conditions
# IMPORTANT: Keep these synchronized with your PaoPaoDNS container settings

TZ=Asia/Shanghai
CNAUTO=yes
CNFALL=yes
IPV6=no
CN_TRACKER=yes
USE_MARK_DATA=yes
CUSTOM_FORWARD=
RULES_TTL=0

# Optional: Additional PaoPaoDNS environment variables
# DNSPORT=53
# DNS_SERVERNAME=PaoPaoDNS,blog.03k.org
# UPDATE=weekly
# SERVER_IP=
# SOCKS5=
# EXPIRED_FLUSH=yes
# CUSTOM_FORWARD_TTL=0
# AUTO_FORWARD=no
# AUTO_FORWARD_CHECK=yes
# USE_HOSTS=no
# HTTP_FILE=no
# SHUFFLE=no
# ADDINFO=no
# SAFEMODE=no
# QUERY_TIME=2000ms
